# Environment variables template for MediaViewer
# Copie este arquivo para .env e preencha suas chaves e senhas reais:
# cp .env.example .env

ADMIN_USERNAME=admin
ADMIN_PASSWORD=altere_esta_senha_forte

# TMDB API Key (v3 auth)
TMDB_API_KEY=

# YouTube Data API v3 Key
YOUTUBE_API_KEY=
YOUTUBE_REFRESH_HOURS=6
