@page "/admin/profiles"
@attribute [Authorize]
@rendermode InteractiveServer
@inject AppDbContext Db

<PageTitle>Perfis — MediaViewer</PageTitle>

<AdminNav />

<h1>Perfis das crianças</h1>

<div class="add-row">
    <input @bind="newName" placeholder="Nome" />
    <input @bind="newColor" type="color" title="Cor do avatar" />
    <button class="btn" @onclick="Add">Adicionar</button>
</div>

<div class="profile-cards">
    @foreach (var p in profiles)
    {
        <div class="profile-card" style="border-color:@p.AvatarColor">
            <div class="avatar" style="background:@p.AvatarColor">@p.Name[..1].ToUpper()</div>
            <input @bind="p.Name" />
            <input @bind="p.AvatarColor" type="color" />
            <div>
                <button class="btn" @onclick="() => Save(p)">Salvar</button>
                <button class="link-btn danger" @onclick="() => Remove(p.Id)">Excluir</button>
            </div>
        </div>
    }
</div>

@code {
    private List<Profile> profiles = [];
    private string newName = "";
    private string newColor = "#e50914";

    protected override async Task OnInitializedAsync()
    {
        profiles = await Db.Profiles.ToListAsync();
    }

    private async Task Add()
    {
        if (string.IsNullOrWhiteSpace(newName)) return;
        var p = new Profile { Name = newName.Trim(), AvatarColor = newColor };
        Db.Profiles.Add(p);
        await Db.SaveChangesAsync();
        profiles.Add(p);
        newName = "";
    }

    private async Task Save(Profile p)
    {
        Db.Profiles.Update(p);
        await Db.SaveChangesAsync();
    }

    private async Task Remove(int id)
    {
        var p = await Db.Profiles.FindAsync(id);
        if (p is not null)
        {
            Db.Profiles.Remove(p);
            await Db.SaveChangesAsync();
            profiles.RemoveAll(x => x.Id == id);
        }
    }
}
