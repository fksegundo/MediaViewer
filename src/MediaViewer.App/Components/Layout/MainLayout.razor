@inherits LayoutComponentBase
@inject AppSettings Settings
@inject NavigationManager Nav

<div class="app-shell">
    <main class="content">
        @Body
    </main>

    <nav class="bottom-nav">
        <NavLink href="/" Match="NavLinkMatch.All">🏠<span>Início</span></NavLink>
        <NavLink href="/youtube">▶<span>YouTube</span></NavLink>
        <NavLink href="/downloads">⬇<span>Baixados</span></NavLink>
        <NavLink href="/profiles">👤<span>@ProfileLabel</span></NavLink>
    </nav>
</div>

@code {
    private string ProfileLabel => Settings.ProfileName ?? "Perfis";
}
